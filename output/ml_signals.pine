//@version=6
indicator("ML Signals — 2026-10-08 (Close)", overlay=true)

if barstate.islast
    t = table.new(position.top_right, 9, 1,
         border_width=1, border_color=color.new(color.white,70),
         frame_width=1, frame_color=color.new(color.white,50))

    table.cell(t, 0, 0, "Instrument", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 1, 0, "Price", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 2, 0, "Chg%", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 3, 0, "Bias", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 4, 0, "Conf (pts)", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 5, 0, "HV / IVR", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 6, 0, "Strategy", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 7, 0, "Strikes (B/S)", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
    table.cell(t, 8, 0, "Expiry", text_color=color.yellow, bgcolor=color.new(color.black,20), text_size=size.small)
